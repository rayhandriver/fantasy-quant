# Copy to .env and adjust. Loaded via python-dotenv.

# Where raw/interim/processed data and the DuckDB file live (default: ./data)
DATA_DIR=./data

# DuckDB database file (point-in-time store)
DUCKDB_PATH=./data/fantasy_quant.duckdb

# League format the backtest scores against (stated baseline)
LEAGUE_TEAMS=10
LEAGUE_SCORING=ppr
LEAGUE_QB=1

# Vegas markets — first-class data source. Free tier: the-odds-api.com (set key) or scrape books.
# ODDS_API_KEY=

# Optional: paid data keys (only if/when we cross the paid line — leave blank for free build)
# FANTASYPROS_API_KEY=
# PLAYERPROFILER_API_KEY=
# Historical prop-line archive (the likely paid gap for backtesting props)
# ODDS_HISTORY_API_KEY=
