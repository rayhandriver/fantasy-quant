ass_rate_neutral":0.8125,"def_epa_per_play":-0.05242},{"week":14,"opponent":"BUF","home":true,"pf":33.0,"pa":27.0,"off_snaps":75,"epa_per_play":0.1702,"pass_rate":0.64,"pass_rate_neutral":0.6571,"def_epa_per_play":0.07561},{"week":15,"opponent":"NO","home":true,"pf":0.0,"pa":9.0,"off_snaps":73,"epa_per_play":-0.3013,"pass_rate":0.7123,"pass_rate_neutral":0.6552,"def_epa_per_play":-0.288},{"week":16,"opponent":"CAR","home":false,"pf":32.0,"pa":6.0,"off_snaps":63,"epa_per_play":0.1831,"pass_rate":0.5079,"pass_rate_neutral":0.5625,"def_epa_per_play":-0.332},{"week":17,"opponent":"NYJ","home":false,"pf":28.0,"pa":24.0,"off_snaps":72,"epa_per_play":0.2506,"pass_rate":0.6944,"pass_rate_neutral":0.6531,"def_epa_per_play":0.1333},{"week":18,"opponent":"CAR","home":true,"pf":41.0,"pa":17.0,"off_snaps":59,"epa_per_play":0.2963,"pass_rate":0.678,"pass_rate_neutral":0.7447,"def_epa_per_play":-0.1963}],"comps":{"offense":[{"season":2023,"team":"WAS","distance":0.5231,"shared":15,"play_caller":null},{"season":2022,"team":"LAC","distance":0.5357,"shared":18,"play_caller":null},{"season":2018,"team":"GB","distance":0.6614,"shared":18,"play_caller":"Mike McCarthy"},{"season":2023,"team":"CIN","distance":0.6677,"shared":15,"play_caller":"Zac Taylor"},{"season":2025,"team":"CIN","distance":0.6939,"shared":15,"play_caller":"Zac Taylor"}],"defense":[{"season":2021,"team":"ARI","distance":0.6681,"shared":18,"play_caller":"Vance Joseph"},{"season":2019,"team":"ARI","distance":0.7707,"shared":18,"play_caller":"Vance Joseph"},{"season":2025,"team":"PIT","distance":0.885,"shared":18,"play_caller":null},{"season":2022,"team":"GB","distance":0.8934,"shared":18,"play_caller":null},{"season":2022,"team":"JAX","distance":0.9127,"shared":18,"play_caller":null}]},"overview":{"overview":"The Buccaneers went 13-4 in 2021 and outscored opponents 511 to 353. Both sides of the ball were strong, with the offense 2nd in EPA per play and the defense 4th in EPA allowed. What set them apart was the highest early-down pass rate and the highest 2-Man rate in the league.","offense":"The Buccaneers had one of the most efficient offenses in the league, ranking in the top eight in four of the five main efficiency measures. They threw more than almost anyone relative to the situation, even when the score did not call for it. Their biggest outliers in how they lined up were the 3rd lowest 21 personnel usage and the 2nd lowest pistol usage in the league. Tom Brady ran the passing game, with Chris Godwin leading the team in targets.","defense":"The Buccaneers had one of the best defenses in the league, ranking 8th or better in four of the five main efficiency measures. The one weak spot was explosive play rate allowed, where they ranked 20th. Jason Pierre-Paul was as productive as expected, but the bigger surprise was Anthony Nelson, who had 5 sacks despite playing only 32% of the snaps. In terms of scheme, they had the highest 2-Man rate in the league.","special":"The Buccaneers were one of the most conservative teams on fourth down, going for it on only 24% of their short-yardage chances. Their kickers made 81% of field goals, which was well below average. On the roster side, they put an unusually large share of their salary cap into receivers, about 16% of the money on the books. The offense also brought back more of its roster than most, with 93% of its snaps going to players who were on the team the year before.","players":"Tom Brady played nearly every snap at quarterback and threw for 5,316 yards. Targets were spread around, with Chris Godwin and Mike Evans leading a group where nobody took more than a fifth of the looks. The backfield was a committee led by Leonard Fournette and Ronald Jones. On defense, Shaquil Barrett led the team with 10 sacks and Mike Edwards picked off 3 passes.","coaching":"This staff is not in the coaching data, so the comparisons below are based on scheme alone. Their offense looked most like the 2023 Commanders and the 2022 Chargers. Their defense looked most like the 2021 and 2019 Cardinals, both under Vance Joseph.","trends":"The offense went from 6th in EPA per play in 2020 to 2nd in 2021, a modest improvement. The defense moved from 6th in EPA allowed per play in 2020 to 4th in 2021, about where it was. The biggest change in approach was no-huddle rate, which went from 4% to 13%.","notes":"FTN did not start charting plays until 2022, so play action, motion, RPO and screen rates are not available for 2021. Everything else, including personnel, formations and coverage, is complete for this season."}}