f_snaps":70,"epa_per_play":-0.1018,"pass_rate":0.7286,"pass_rate_neutral":0.7547,"def_epa_per_play":-0.3803},{"week":13,"opponent":"WAS","home":true,"pf":17.0,"pa":23.0,"off_snaps":67,"epa_per_play":-0.1555,"pass_rate":0.791,"pass_rate_neutral":0.7797,"def_epa_per_play":-0.08235},{"week":14,"opponent":"BUF","home":false,"pf":15.0,"pa":26.0,"off_snaps":56,"epa_per_play":-0.2868,"pass_rate":0.6964,"pass_rate_neutral":0.6111,"def_epa_per_play":-0.08674},{"week":15,"opponent":"CIN","home":false,"pf":17.0,"pa":27.0,"off_snaps":61,"epa_per_play":-0.3348,"pass_rate":0.6393,"pass_rate_neutral":0.75,"def_epa_per_play":-0.1158},{"week":16,"opponent":"IND","home":true,"pf":28.0,"pa":24.0,"off_snaps":62,"epa_per_play":-0.008451,"pass_rate":0.8065,"pass_rate_neutral":0.7,"def_epa_per_play":0.003139},{"week":17,"opponent":"CLE","home":false,"pf":22.0,"pa":24.0,"off_snaps":66,"epa_per_play":0.1114,"pass_rate":0.697,"pass_rate_neutral":0.7,"def_epa_per_play":0.1742}],"comps":{"offense":[{"season":2022,"team":"CIN","distance":0.4472,"shared":18,"play_caller":"Zac Taylor"},{"season":2023,"team":"CIN","distance":0.532,"shared":15,"play_caller":"Zac Taylor"},{"season":2024,"team":"SEA","distance":0.5622,"shared":15,"play_caller":null},{"season":2023,"team":"WAS","distance":0.5835,"shared":15,"play_caller":null},{"season":2025,"team":"CIN","distance":0.61,"shared":15,"play_caller":"Zac Taylor"}],"defense":[{"season":2022,"team":"LAC","distance":0.7191,"shared":18,"play_caller":"Brandon Staley"},{"season":2021,"team":"BAL","distance":0.7241,"shared":18,"play_caller":null},{"season":2023,"team":"DEN","distance":0.7415,"shared":18,"play_caller":"Vance Joseph"},{"season":2024,"team":"DEN","distance":0.8733,"shared":18,"play_caller":"Vance Joseph"},{"season":2018,"team":"GB","distance":0.8985,"shared":18,"play_caller":null}]},"overview":{"overview":"The Steelers went 12-4 in 2020 and outscored opponents 416 to 312. The defense did most of the work, finishing 2nd in EPA allowed while the offense ranked 17th in EPA per play. What set them apart was the highest neutral-script pass rate and the 3rd most pass rushers in the league.","offense":"The Steelers offense struggled, ranking 25th or worse in three of the five main efficiency measures. They threw more than almost anyone relative to the situation, even when the score did not call for it. Schematically, they stood out for the 2nd highest empty formation usage and the 2nd highest 11 personnel usage in the league. Ben Roethlisberger ran the passing game, with Diontae Johnson leading the team in targets.","defense":"The Steelers had one of the best defenses in the league, ranking 2nd or better in three of the five main efficiency measures. Its strongest area was sack rate, where it led the league, and it had no real weak spot. T.J. Watt was as productive as expected, but the bigger surprise was Mike Hilton, who had 3 sacks, after doing little as a pass rusher a year ago. Schematically, they had the 3rd most pass rushers in the league.","special":"The Steelers were about average in how often they went for it on fourth down. Their kickers made 96% of field goals, which was one of the best in the league. On the roster side, they put an unusually large share of their salary cap into the quarterback, about 16% of the money on the books. Their receivers were among the youngest in the league.","players":"Ben Roethlisberger played nearly every snap at quarterback and threw for 3,803 yards. Diontae Johnson was the clear top target with 22% of the looks and 923 receiving yards. The backfield was a committee led by James Conner and Benny Snell. On defense, T.J. Watt led the team with 15 sacks and Minkah Fitzpatrick picked off 4 passes.","coaching":"This staff is not in the coaching data, so the comparisons below are based on scheme alone. Their offense looked most like the 2022 and 2023 Bengals, both under Zac Taylor. Their defense looked most like the 2022 Chargers under Brandon Staley and the 2021 Ravens.","trends":"The offense went from 32nd in EPA per play in 2019 to 17th in 2020, a big step forward. The defense moved from 3rd in EPA allowed per play in 2019 to 2nd in 2020, about where it was. The biggest change in approach was early-down pass rate, which went from 51% to 63%.","notes":"FTN did not start charting plays until 2022, so play action, motion, RPO and screen rates are not available for 2020. Everything else, including personnel, formations and coverage, is complete for this season."}}