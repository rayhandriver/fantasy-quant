ate":0.7045,"pass_rate_neutral":0.5217,"def_epa_per_play":-0.001348},{"week":13,"opponent":"LA","home":true,"pf":31.0,"pa":28.0,"off_snaps":59,"epa_per_play":0.2376,"pass_rate":0.3729,"pass_rate_neutral":0.375,"def_epa_per_play":0.1398},{"week":15,"opponent":"NO","home":false,"pf":17.0,"pa":20.0,"off_snaps":56,"epa_per_play":0.1101,"pass_rate":0.4464,"pass_rate_neutral":0.4082,"def_epa_per_play":0.1064},{"week":16,"opponent":"TB","home":true,"pf":23.0,"pa":20.0,"off_snaps":53,"epa_per_play":0.1006,"pass_rate":0.6415,"pass_rate_neutral":0.6383,"def_epa_per_play":0.1069},{"week":17,"opponent":"SEA","home":true,"pf":10.0,"pa":27.0,"off_snaps":49,"epa_per_play":-0.5107,"pass_rate":0.5306,"pass_rate_neutral":0.5161,"def_epa_per_play":-0.05359},{"week":18,"opponent":"TB","home":false,"pf":14.0,"pa":16.0,"off_snaps":47,"epa_per_play":-0.02143,"pass_rate":0.7234,"pass_rate_neutral":0.5833,"def_epa_per_play":0.00604}],"comps":{"offense":[{"season":2024,"team":"TEN","distance":0.5832,"shared":22,"play_caller":null},{"season":2024,"team":"JAX","distance":0.5866,"shared":22,"play_caller":null},{"season":2024,"team":"NYG","distance":0.649,"shared":22,"play_caller":"Brian Daboll"},{"season":2023,"team":"TB","distance":0.6493,"shared":22,"play_caller":"Dave Canales"},{"season":2022,"team":"NYG","distance":0.6809,"shared":21,"play_caller":"Mike Kafka"}],"defense":[{"season":2023,"team":"TEN","distance":0.631,"shared":22,"play_caller":null},{"season":2021,"team":"LA","distance":0.7005,"shared":18,"play_caller":"Raheem Morris"},{"season":2019,"team":"NYG","distance":0.7139,"shared":18,"play_caller":null},{"season":2022,"team":"LA","distance":0.7315,"shared":22,"play_caller":"Raheem Morris"},{"season":2020,"team":"LA","distance":0.7819,"shared":18,"play_caller":"Brandon Staley"}]},"overview":{"overview":"The Panthers went 8-9 in 2025 and were outscored 380 to 311. Neither side held up, as the offense ranked 26th in EPA per play and the defense 23rd in EPA allowed. What set them apart was the fewest backs in the backfield and the 2nd lowest 2-Man rate in the league.","offense":"The Panthers offense was well below average by EPA per play. They were one of the most run-heavy teams in the league, passing less often than game situations would predict. Their biggest outliers in how they lined up were the fewest backs in the backfield and the 2nd lowest pre-snap motion rate in the league. Bryce Young ran the passing game and leaned heavily on Tetairoa McMillan, who drew 25% of the targets.","defense":"The Panthers defense was well below average by EPA allowed per play. Its strongest area was explosive play rate allowed, where it ranked 12th, and its weakest was pressure rate, where it ranked 32nd. Derrick Brown led the team with 5 sacks, and Nic Scourton added 5, after not being a regular on this defense last season. In terms of scheme, they had the 2nd lowest 2-Man rate in the league.","special":"The Panthers were one of the most aggressive teams on fourth down, going for it on 73% of their short-yardage chances in normal situations. Their kickers made 83% of field goals, which was a little below average. On the roster side, they put an unusually large share of their salary cap into the offensive line, about 27% of the money on the books. Their running backs were among the youngest in the league.","players":"Bryce Young played nearly every snap at quarterback and threw for 3,011 yards. Tetairoa McMillan was the clear top target with 25% of the looks and 1,014 receiving yards. Rico Dowdle handled most of the work in the backfield with 59% of the carries. On defense, Derrick Brown led the team with 5 sacks and Jaycee Horn picked off 5 passes.","coaching":"Dave Canales called the offense as head coach and Ejiro Evero called the defense. Their offense looked most like the 2024 Titans and the 2024 Jaguars. Their defense looked most like the 2023 Titans and the 2021 Rams under Raheem Morris.","trends":"The offense went from 23rd in EPA per play in 2024 to 26th in 2025, a modest decline. The defense moved from 32nd in EPA allowed per play in 2024 to 23rd in 2025, a big step forward. The biggest change in approach was fourth down go rate, which went from 29% to 73%.","notes":"Every data source is available for 2025. This season uses the newer formation labels, which group singleback, I formation and empty sets together as under center, so those older formation rates are not shown."}}