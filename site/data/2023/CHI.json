epa_per_play":0.01887,"pass_rate":0.3571,"pass_rate_neutral":0.4151,"def_epa_per_play":0.07416},{"week":12,"opponent":"MIN","home":false,"pf":12.0,"pa":10.0,"off_snaps":65,"epa_per_play":-0.1209,"pass_rate":0.6154,"pass_rate_neutral":0.6071,"def_epa_per_play":-0.5115},{"week":14,"opponent":"DET","home":true,"pf":28.0,"pa":13.0,"off_snaps":65,"epa_per_play":0.04248,"pass_rate":0.5692,"pass_rate_neutral":0.625,"def_epa_per_play":-0.1477},{"week":15,"opponent":"CLE","home":false,"pf":17.0,"pa":20.0,"off_snaps":70,"epa_per_play":-0.3112,"pass_rate":0.6143,"pass_rate_neutral":0.5962,"def_epa_per_play":-0.3704},{"week":16,"opponent":"ARI","home":true,"pf":27.0,"pa":16.0,"off_snaps":67,"epa_per_play":0.1165,"pass_rate":0.4179,"pass_rate_neutral":0.4286,"def_epa_per_play":-0.1575},{"week":17,"opponent":"ATL","home":true,"pf":37.0,"pa":17.0,"off_snaps":72,"epa_per_play":0.1274,"pass_rate":0.4861,"pass_rate_neutral":0.5,"def_epa_per_play":-0.07273},{"week":18,"opponent":"GB","home":false,"pf":9.0,"pa":17.0,"off_snaps":46,"epa_per_play":-0.09558,"pass_rate":0.4565,"pass_rate_neutral":0.5,"def_epa_per_play":0.2359}],"comps":{"offense":[{"season":2025,"team":"GB","distance":0.6361,"shared":22,"play_caller":"Matt LaFleur"},{"season":2022,"team":"WAS","distance":0.6804,"shared":21,"play_caller":null},{"season":2024,"team":"TEN","distance":0.6869,"shared":22,"play_caller":null},{"season":2023,"team":"PIT","distance":0.7553,"shared":22,"play_caller":null},{"season":2024,"team":"PHI","distance":0.7605,"shared":22,"play_caller":"Kellen Moore"}],"defense":[{"season":2021,"team":"PHI","distance":0.4878,"shared":18,"play_caller":"Jonathan Gannon"},{"season":2023,"team":"SF","distance":0.5179,"shared":22,"play_caller":null},{"season":2023,"team":"IND","distance":0.5536,"shared":22,"play_caller":null},{"season":2019,"team":"IND","distance":0.6115,"shared":18,"play_caller":null},{"season":2018,"team":"CIN","distance":0.6121,"shared":18,"play_caller":null}]},"overview":{"overview":"The Bears went 7-10 in 2023 and were outscored 379 to 360. The offense ranked 19th in EPA per play and the defense 14th in EPA allowed, so neither side stood out much. What set them apart was the 2nd lowest pass rate and the 2nd highest Cover 2 rate in the league.","offense":"The Bears offense was a little below average by EPA per play, and it was much better running the ball than passing it. They were one of the most run-heavy teams in the league, passing less often than game situations would predict. Their biggest outliers in how they lined up were the 3rd highest pistol usage in the league. Justin Fields ran the passing game and leaned heavily on DJ Moore, who drew 29% of the targets.","defense":"The Bears defense was a little above average by EPA allowed per play. Its strongest area was takeaways per game, where it ranked 5th, and its weakest was sack rate, where it ranked 32nd. Montez Sweat led the team with 6 sacks, and Yannick Ngakoue added 4, after not being a regular on this defense last season. In terms of scheme, they had the 2nd highest Cover 2 rate in the league.","special":"The Bears were one of the most aggressive teams on fourth down, going for it on 52% of their short-yardage chances in normal situations. Their kickers made 92% of field goals, which was well above average. On the roster side, they put an unusually large share of their salary cap into the defensive line, about 25% of the money on the books. Their tight ends were among the oldest in the league.","players":"Justin Fields played nearly every snap at quarterback and threw for 2,562 yards. DJ Moore was the clear top target with 29% of the looks and 1,364 receiving yards. The backfield was a committee led by Khalil Herbert and D'Onta Foreman. On defense, Montez Sweat led the team with 6 sacks and Tremaine Edmunds picked off 4 passes.","coaching":"This staff is not in the coaching data, so the comparisons below are based on scheme alone. Their offense looked most like the 2025 Packers under Matt LaFleur and the 2022 Commanders. Their defense looked most like the 2021 Eagles under Jonathan Gannon and the 2023 49ers.","trends":"The offense went from 23rd in EPA per play in 2022 to 19th in 2023, a modest improvement. The defense moved from 32nd in EPA allowed per play in 2022 to 14th in 2023, a big step forward. The biggest change in approach was Cover 4 rate, which went from 6% to 15%.","notes":"Every data source is available for 2023. This season uses the newer formation labels, which group singleback, I formation and empty sets together as under center, so those older formation rates are not shown."}}