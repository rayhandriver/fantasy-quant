12,"opponent":"ARI","home":false,"pf":25.0,"pa":24.0,"off_snaps":64,"epa_per_play":0.0691,"pass_rate":0.8125,"pass_rate_neutral":0.825,"def_epa_per_play":0.05806},{"week":13,"opponent":"LV","home":false,"pf":20.0,"pa":27.0,"off_snaps":73,"epa_per_play":-0.1051,"pass_rate":0.7123,"pass_rate_neutral":0.6596,"def_epa_per_play":-0.08893},{"week":14,"opponent":"MIA","home":true,"pf":23.0,"pa":17.0,"off_snaps":76,"epa_per_play":0.02775,"pass_rate":0.7237,"pass_rate_neutral":0.7302,"def_epa_per_play":-0.08261},{"week":15,"opponent":"TEN","home":true,"pf":17.0,"pa":14.0,"off_snaps":67,"epa_per_play":-0.06505,"pass_rate":0.6418,"pass_rate_neutral":0.6167,"def_epa_per_play":-0.05399},{"week":16,"opponent":"IND","home":false,"pf":20.0,"pa":3.0,"off_snaps":64,"epa_per_play":-0.05077,"pass_rate":0.5469,"pass_rate_neutral":0.6522,"def_epa_per_play":-0.5724},{"week":17,"opponent":"LA","home":true,"pf":31.0,"pa":10.0,"off_snaps":62,"epa_per_play":0.2857,"pass_rate":0.5,"pass_rate_neutral":0.5526,"def_epa_per_play":-0.1024},{"week":18,"opponent":"DEN","home":false,"pf":28.0,"pa":31.0,"off_snaps":67,"epa_per_play":0.05254,"pass_rate":0.6866,"pass_rate_neutral":0.7091,"def_epa_per_play":0.1469}],"comps":{"offense":[{"season":2024,"team":"NYJ","distance":0.4436,"shared":21,"play_caller":null},{"season":2023,"team":"DAL","distance":0.6376,"shared":21,"play_caller":"Mike McCarthy"},{"season":2025,"team":"DEN","distance":0.6513,"shared":21,"play_caller":"Sean Payton"},{"season":2023,"team":"WAS","distance":0.6526,"shared":21,"play_caller":null},{"season":2025,"team":"MIN","distance":0.6686,"shared":21,"play_caller":"Kevin O'Connell"}],"defense":[{"season":2021,"team":"BAL","distance":0.4769,"shared":18,"play_caller":null},{"season":2023,"team":"DEN","distance":0.5515,"shared":22,"play_caller":"Vance Joseph"},{"season":2024,"team":"DEN","distance":0.5762,"shared":22,"play_caller":"Vance Joseph"},{"season":2024,"team":"NYJ","distance":0.651,"shared":22,"play_caller":"Jeff Ulbrich"},{"season":2018,"team":"NYJ","distance":0.6656,"shared":18,"play_caller":null}]},"overview":{"overview":"The Chargers went 10-7 in 2022 and outscored opponents 391 to 384. The offense ranked 13th in EPA per play and the defense 19th in EPA allowed, so neither side stood out much. What set them apart was the 2nd highest early-down pass rate in the league.","offense":"The Chargers offense was a little above average by EPA per play. They threw more than almost anyone relative to the situation, even when the score did not call for it. Justin Herbert ran the passing game, with Austin Ekeler leading the team in targets.","defense":"The Chargers defense was a little below average by EPA allowed per play. It was much better against the pass than the run, ranking 10th and 30th. Joey Bosa was as productive as expected, but the bigger surprise was Khalil Mack, who had 8 sacks, after not being a regular on this defense last season. Their scheme was fairly conventional, and the closest thing to a signature was a blitz rate that ranked 4th highest in the league.","special":"The Chargers were about average in how often they went for it on fourth down. Their kickers made 94% of field goals, which was one of the best in the league. On the roster side, they put an unusually large share of their salary cap into linebackers, about 24% of the money on the books.","players":"Justin Herbert played nearly every snap at quarterback and threw for 4,739 yards. Targets were spread around, with Austin Ekeler and Josh Palmer leading a group where nobody took more than a fifth of the looks. Austin Ekeler handled most of the work in the backfield with 58% of the carries. On defense, Khalil Mack led the team with 8 sacks and Bryce Callahan picked off 3 passes.","coaching":"This staff is not in the coaching data, so the comparisons below are based on scheme alone. Their offense looked most like the 2024 Jets and the 2023 Cowboys under Mike McCarthy. Their defense looked most like the 2021 Ravens and the 2023 Broncos under Vance Joseph.","trends":"The offense went from 6th in EPA per play in 2021 to 13th in 2022, a modest decline. The defense moved from 24th in EPA allowed per play in 2021 to 19th in 2022, a modest improvement. The biggest change in approach was two point attempt rate, which went from 19% to 5%.","notes":"2022 is the first season with every data source available, including FTN's play design charting. It is also the last season that used the older formation labels, so singleback and I formation rates still appear here."}}