eek":10,"opponent":"LAC","home":true,"pf":20.0,"pa":23.0,"off_snaps":65,"epa_per_play":-0.04876,"pass_rate":0.7692,"pass_rate_neutral":0.7,"def_epa_per_play":0.008007},{"week":11,"opponent":"CAR","home":false,"pf":33.0,"pa":35.0,"off_snaps":61,"epa_per_play":0.04635,"pass_rate":0.6393,"pass_rate_neutral":0.5952,"def_epa_per_play":0.0604}],"comps":{"offense":[{"season":2023,"team":"CHI","distance":0.513,"shared":12,"play_caller":null},{"season":2025,"team":"GB","distance":0.5791,"shared":12,"play_caller":"Matt LaFleur"},{"season":2023,"team":"GB","distance":0.6042,"shared":12,"play_caller":"Matt LaFleur"},{"season":2022,"team":"TEN","distance":0.6131,"shared":12,"play_caller":null},{"season":2024,"team":"TEN","distance":0.6165,"shared":12,"play_caller":null}],"defense":[{"season":2023,"team":"LAC","distance":0.2614,"shared":4,"play_caller":"Brandon Staley"},{"season":2023,"team":"JAX","distance":0.3039,"shared":4,"play_caller":null},{"season":2024,"team":"CAR","distance":0.3393,"shared":4,"play_caller":"Ejiro Evero"},{"season":2025,"team":"ARI","distance":0.3405,"shared":4,"play_caller":"Nick Rallis"},{"season":2023,"team":"NE","distance":0.3896,"shared":4,"play_caller":null}]},"overview":{"overview":"The Ravens are 4-7 through week 11 of the 2026 season and have been outscored 294 to 242. The offense ranks 16th in EPA per play and the defense 18th in EPA allowed, so neither side has stood out much yet.","offense":"The Ravens offense has been about average by EPA per play so far. Their run and pass mix has stayed close to what game situations call for. Tyler Huntley has run the passing game and leaned heavily on Zay Flowers, who has drawn 25% of the targets.","defense":"The Ravens defense has been about average by EPA allowed per play so far. Its strongest area has been explosive play rate allowed, where it ranks 11th, and its weakest has been takeaways per game, where it ranks 25th. Mike Green has led the way with 7.5 sacks. Their scheme has been fairly conventional, and the closest thing to a signature is a number of defenders in the box that ranks 5th lowest in the league.","special":"The Ravens have been about average in how often they go for it on fourth down. Their kickers have made 81% of field goals, which is a little below average. On the roster side, they put an unusually large share of their salary cap into the quarterback, about 21% of the money on the books. Their defensive line was among the oldest in the league.","players":"The quarterback job has been split, with Tyler Huntley and Lamar Jackson both getting meaningful snaps. Zay Flowers has been the clear top target with 25% of the looks and 785 receiving yards. Derrick Henry has handled most of the work in the backfield with 78% of the carries. On defense, Mike Green leads the team with 7.5 sacks.","coaching":"Declan Doyle is calling the offense and Jesse Minter is calling the defense. Their offense looks most like the 2023 Bears and the 2025 Packers under Matt LaFleur. Their defense looks most like the 2023 Chargers under Brandon Staley and the 2023 Jaguars.","trends":"The offense went from 12th in EPA per play in 2025 to 16th so far this season, a modest decline. The defense moved from 20th in EPA allowed per play in 2025 to 18th so far this season, about where it was. The biggest change in approach was number of pass rushers, which went from 4.23 to 4.43.","notes":"The 2026 pages are built from data that nflverse updates every week, so they will keep changing until the season ends. Personnel, formations, coverage and pressure numbers are missing for now because that data is only released after the season."}}