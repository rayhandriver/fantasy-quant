al":0.44,"def_epa_per_play":-0.1425},{"week":13,"opponent":"CHI","home":true,"pf":23.0,"pa":20.0,"off_snaps":69,"epa_per_play":0.07395,"pass_rate":0.5217,"pass_rate_neutral":0.4231,"def_epa_per_play":-0.00925},{"week":14,"opponent":"GB","home":true,"pf":34.0,"pa":31.0,"off_snaps":76,"epa_per_play":0.06129,"pass_rate":0.5526,"pass_rate_neutral":0.5606,"def_epa_per_play":0.1319},{"week":15,"opponent":"BUF","home":true,"pf":42.0,"pa":48.0,"off_snaps":75,"epa_per_play":0.2577,"pass_rate":0.8,"pass_rate_neutral":0.8571,"def_epa_per_play":0.4799},{"week":16,"opponent":"CHI","home":false,"pf":34.0,"pa":17.0,"off_snaps":64,"epa_per_play":0.3233,"pass_rate":0.5156,"pass_rate_neutral":0.4667,"def_epa_per_play":0.01418},{"week":17,"opponent":"SF","home":false,"pf":40.0,"pa":34.0,"off_snaps":67,"epa_per_play":0.3857,"pass_rate":0.5522,"pass_rate_neutral":0.5294,"def_epa_per_play":0.3441},{"week":18,"opponent":"MIN","home":true,"pf":31.0,"pa":9.0,"off_snaps":66,"epa_per_play":0.01481,"pass_rate":0.5303,"pass_rate_neutral":0.5745,"def_epa_per_play":-0.3382}],"comps":{"offense":[{"season":2025,"team":"CHI","distance":0.5738,"shared":22,"play_caller":"Ben Johnson"},{"season":2022,"team":"CAR","distance":0.8363,"shared":21,"play_caller":null},{"season":2022,"team":"DAL","distance":0.9192,"shared":21,"play_caller":"Kellen Moore"},{"season":2023,"team":"TEN","distance":0.9278,"shared":22,"play_caller":null},{"season":2024,"team":"MIN","distance":0.9496,"shared":22,"play_caller":"Kevin O'Connell"}],"defense":[{"season":2020,"team":"JAX","distance":0.8472,"shared":18,"play_caller":null},{"season":2024,"team":"DEN","distance":0.856,"shared":22,"play_caller":"Vance Joseph"},{"season":2018,"team":"DEN","distance":0.8584,"shared":18,"play_caller":null},{"season":2023,"team":"DEN","distance":0.9353,"shared":22,"play_caller":"Vance Joseph"},{"season":2020,"team":"ARI","distance":0.9423,"shared":18,"play_caller":"Vance Joseph"}]},"overview":{"overview":"The Lions went 15-2 in 2024 and outscored opponents 564 to 342. Both sides of the ball were strong, with the offense 3rd in EPA per play and the defense 6th in EPA allowed. What set them apart was the highest play-action rate and the highest base defense usage in the league.","offense":"The Lions had one of the most efficient offenses in the league, ranking in the top eight in all five main efficiency measures. Their run and pass mix stayed close to what game situations called for. Schematically, they stood out for the highest play-action rate and the lowest shotgun rate in the league. Jared Goff ran the passing game and leaned heavily on Amon-Ra St. Brown, who drew 27% of the targets.","defense":"The Lions had one of the best defenses in the league, ranking 7th or better in three of the five main efficiency measures. The one weak spot was explosive play rate allowed, where they ranked 25th. Aidan Hutchinson was as productive as expected, but the bigger surprise was Za'Darius Smith, who had 4 sacks, after not being a regular on this defense last season. In terms of scheme, they had the highest base defense usage in the league.","special":"The Lions were one of the most aggressive teams on fourth down, going for it on 55% of their short-yardage chances in normal situations. Their kickers made 90% of field goals, which was well above average. Their salary cap was spread across positions in a fairly typical way. The offense also brought back more of its roster than most, with 85% of its snaps going to players who were on the team the year before.","players":"Jared Goff played nearly every snap at quarterback and threw for 4,629 yards. Amon-Ra St. Brown was the clear top target with 27% of the looks and 1,263 receiving yards. The backfield was a committee led by Jahmyr Gibbs and David Montgomery. On defense, Aidan Hutchinson led the team with 7.5 sacks and Kerby Joseph picked off 9 passes.","coaching":"Ben Johnson called the offense and Aaron Glenn called the defense. Their offense looked most like the 2025 Bears under Ben Johnson and the 2022 Panthers. Their defense looked most like the 2020 Jaguars and the 2024 Broncos under Vance Joseph.","trends":"The offense went from 7th in EPA per play in 2023 to 3rd in 2024, a modest improvement. The defense moved from 17th in EPA allowed per play in 2023 to 6th in 2024, a big step forward. The biggest change in approach was two-high safety rate, which went from 44% to 97%.","notes":"Every data source is available for 2024. This season uses the newer formation labels, which group singleback, I formation and empty sets together as under center, so those older formation rates are not shown."}}